                    <mxGeometry y="446" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l6-b" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l6" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l6-d" value="&lt;div&gt;&lt;b&gt;Catalog reads metadata&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Title, status, thumbnail key and tier_required come from a single on-demand DynamoDB table.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l6" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l7" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="526" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l7-b" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l7" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l7-d" value="&lt;div&gt;&lt;b&gt;Upload by presigned URL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The service only signs the URL; the video bytes go straight from the browser to the raw bucket.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l7" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l8" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="606" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l8-b" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l8" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l8-d" value="&lt;div&gt;&lt;b&gt;Object-created event&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The upload raises an S3 event that an EventBridge rule routes onward. No polling, no coupling.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l8" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l9" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="686" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l9-b" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l9" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l9-d" value="&lt;div&gt;&lt;b&gt;Durable job queue&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;SQS buffers the work and a DLQ catches poison messages after repeated failures.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l9" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l10" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="766" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l10-b" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l10" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l10-d" value="&lt;div&gt;&lt;b&gt;KEDA scales the worker from zero&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Queue depth drives replica count on the spot node group; an idle system runs no transcode pods at all.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l10" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l11" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="846" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l11-b" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l11" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l11-d" value="&lt;div&gt;&lt;b&gt;FFmpeg writes HLS renditions&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;240p to 1080p segments plus a thumbnail land in the transcoded bucket.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l11" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l12" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="926" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l12-b" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l12" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l12-d" value="&lt;div&gt;&lt;b&gt;Status flips to ready&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The worker updates DynamoDB and deletes the message idempotently, so a retry is harmless.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l12" vertex="1">
                    <mxGeometry x="52" width="548" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l13" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="1006" width="600" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l13-b" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="l13" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="l13-d" value="&lt;div&gt;&lt;b&gt;Tier check and signed cookie&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Playback compares the JWT group against tier_required, reads the private key from Secrets Manager (dashed line) and returns a short-lived CloudFront signed cookie. On expiry the browser gets a 403 and asks for a fresh one.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l13" vertex="1">
                    <mxGeometry x="52" width="548" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
