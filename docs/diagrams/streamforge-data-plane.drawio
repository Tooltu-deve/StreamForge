                </mxCell>
                <mxCell id="l2-d" value="&lt;div&gt;&lt;b&gt;Default origin serves the SPA&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The React build is read from a private S3 bucket through Origin Access Control.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="l2" vertex="1">
